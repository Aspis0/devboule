      "example": { "args": { "requestId": "req-1", "note": null } },
      "sideEffects": "unblocks agent"
    },
    {
      "name": "deny_plan_request",
      "purpose": "Deny pending plan request",
      "args": { "requestId": "string", "note": "string|null" },
      "example": { "args": { "requestId": "req-1", "note": "needs work" } },
      "sideEffects": "rejects plan"
    },
