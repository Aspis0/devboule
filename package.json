{
  "name": "devboule",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "mcp:stage": "bash scripts/stage-devboule-mcp.sh",
    "mcp:soak": "bash scripts/soak-devboule-mcp.sh",
    "devboule-pilot:app": "bash tools/devboule-pilot/run-app.sh",
    "devboule-pilot:smoke": "bash tools/devboule-pilot/smoke-ping.sh",
    "test": "vitest run",
    "test:design": "VITEST_INCLUDE_DESIGN=1 vitest run src/components/design",
    "test:all": "VITEST_INCLUDE_DESIGN=1 vitest run",
    "test:watch": "vitest",
    "rig:smoke": "RIG=1 oracle-data/venv/bin/python -m pytest rig/ -v",
    "rig:rust": "cargo test --manifest-path src-tauri/Cargo.toml rig_tests -- --ignored",
    "rig": "npm run rig:smoke && npm run rig:rust",
    "devboule-pilot:up": "bash tools/devboule-pilot/up.sh --start-app",
    "devboule-pilot:ready": "bash tools/devboule-pilot/ready.sh",
    "devboule-pilot:session": "bash tools/devboule-pilot/scenarios/smoke-session.sh",
    "devboule-pilot:projects": "bash tools/devboule-pilot/scenarios/list-projects.sh",
    "devboule-pilot:chrome": "bash tools/devboule-pilot/scenarios/run-chrome-shell.sh"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.12",
    "gsap": "^3.15.0",
    "lucide-react": "^0.460.0",
    "perfect-arrows": "^0.3.7",
    "pixi-filters": "^6.1.5",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.27.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^8.0.14",
    "vitest": "^3.2.4"
  }
}
