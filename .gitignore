!.pi/agents/
!.pi/agents/*.md

# devboule-mcp build artifacts
devboule-mcp/target/

# Staged Tauri externalBin binaries (rebuilt by scripts/stage-devboule-mcp.sh)
src-tauri/binaries/devboule-mcp*
src-tauri/binaries/devboule-mcp-*
!src-tauri/binaries/README.md

# Staged Oracle ONNX int8 weights (full package only; rebuilt by
